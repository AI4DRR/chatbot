# PostgreSQL
# Canonical (container-side) URL: the API runs inside Compose and reaches the
# database by service name. This is what both compose files expect.
DATABASE_URL=postgresql://undrr:undrrpassword@postgres:5432/undrr_chat
# Host-side tools only (not used by the containers): publish the DB port via a
# local override (see docker-compose.yml) and point them at e.g.
# postgresql://undrr:undrrpassword@localhost:5433/undrr_chat
# docker-compose.prod.yml reads DATABASE_URL from this file: a localhost host
# does not resolve to Postgres inside the API container, so the value above
# (service name `postgres`) is the one to keep here.

# Optional: Docker database configuration (used in docker-compose.prod.yml)
# If not set, defaults to: undrr / undrrpassword / undrr_chat
# DB_USER=undrr
# DB_PASSWORD=undrrpassword
# DB_NAME=undrr_chat

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://[RESOURCE NAME].openai.azure.com/
AZURE_OPENAI_API_KEY=***
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Deployments
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Azure AI Search
AZURE_SEARCH_ENDPOINT="https://[RESOURCE NAME].search.windows.net"
AZURE_SEARCH_KEY=***
AZURE_SEARCH_INDEX=preventionweb-all
# Candidate chunks asked from the index per question (semantic ranking allows up to 50).
# The index is chunked, so many candidates belong to the same document; they are grouped
# and capped by CHAT_KB_MAX_DOCUMENTS below. 40 = Phase 1 default (was 15).
KB_TOP_K=40

# Debug Logging
# Set to 'true' for verbose pipeline logging once the chat pipeline is ported
# (equivalent to LOG_LEVEL=DEBUG, see docs/architecture.md). Off by default.
CHAT_DEBUG=false

# Answer pipeline behind POST /api/chat.
#   unconfigured (default) — /api/chat answers 503
#   stub                   — dev/test only: echoes the question, clearly marked, no AI
#   rag                    — Azure AI Search (one semantic query) + Azure OpenAI (one
#                            completion) with numbered [n] citations; needs the
#                            AZURE_SEARCH_* and AZURE_OPENAI_* values above
CHAT_PIPELINE=unconfigured

# RAG pipeline limits (defaults shown; all optional)
# CHAT_KB_MAX_DOCUMENTS=8              distinct documents offered to the model after grouping chunks
# CHAT_HISTORY_MESSAGES=6              recent raw messages of the session sent to the model
# CHAT_KB_EXCERPT_CHARS=6000           characters per retrieved document (its grouped chunks)
# CHAT_KB_CONTEXT_CHARS=40000          characters of all excerpts together
# CHAT_MAX_COMPLETION_TOKENS=8000      completion cap; gpt-5 reasons first (4000 gave empty answers on long turns)
# CHAT_COMPLETION_TIMEOUT_SECONDS=90   Azure OpenAI request timeout
# CHAT_SEARCH_TIMEOUT_SECONDS=20       Azure AI Search connect/read timeout
# CHAT_REASONING_EFFORT=               optional gpt-5 reasoning control for the answer call
#                                      (minimal|low|medium|high); sent only when set. Phase 3 measured
#                                      on gpt-5: baseline 27-44 s → low 13-21 s → minimal 11-12 s per
#                                      answer with citations preserved. Unset = provider default.

# Internal LLM (Phase 2): query routing before retrieval, active subject, memory
# summarisation. Every connection value falls back to the AZURE_OPENAI_* value
# above, so with nothing set here the internal model IS the answer deployment.
# Point these at a cheaper/faster deployment later without touching the RAG flow.
# INTERNAL_LLM_ENDPOINT=
# INTERNAL_LLM_API_KEY=
# INTERNAL_LLM_API_VERSION=
# INTERNAL_LLM_DEPLOYMENT=
# INTERNAL_LLM_TIMEOUT_SECONDS=30
# INTERNAL_LLM_MAX_COMPLETION_TOKENS=3000  visible output is tiny, but gpt-5 reasons first (800 was too small)
# INTERNAL_LLM_REASONING_EFFORT=       optional (minimal|low|medium|high); sent only when set. On gpt-5,
#                                      minimal cut routing from ~9 s / ~560 tokens to ~2 s / ~50 tokens
#                                      with equivalent rewrites (Phase 3 probe).
# INTERNAL_LLM_JSON_MODE=false         send response_format=json_object on internal calls; accepted by
#                                      gpt-5 but no measurable gain over the tolerant parser (Phase 3).

# Conversation memory (Phase 2). The model always sees every message not yet
# covered by the session summary (at least CHAT_HISTORY_MESSAGES, at most
# CHAT_MEMORY_COMPACT_AFTER). Older messages are folded into
# chat_sessions.memory_summary on the internal model when a session has more
# than COMPACT_AFTER messages and at least COMPACT_EVERY of them sit outside
# both the summary and the raw window. 0 disables compaction.
# CHAT_MEMORY_COMPACT_AFTER=12
# CHAT_MEMORY_COMPACT_EVERY=6

# Optional: Semantic search configuration (defaults to "semantic-config")
# AZURE_SEARCH_SEMANTIC_CONFIG=semantic-config

# ----------------------------
# Cost Tracking
# ----------------------------
# Pricing per 1,000 tokens in USD — update to match your Azure deployment pricing.
# Find current rates at: https://azure.microsoft.com/pricing/details/cognitive-services/openai-service/
# GPT-4o example: input=$0.0025/1K, output=$0.01/1K
# GPT-4-turbo example: input=$0.01/1K, output=$0.03/1K
# Set to 0.0 to disable cost tracking (tokens are still recorded).
AZURE_COST_INPUT_PER_1K=0.0
AZURE_COST_OUTPUT_PER_1K=0.0

# ==================== AUTHENTICATION (2026-09-20) ====================
# Browser sessions: an HttpOnly, SameSite=Lax cookie holding a random token whose
# SHA-256 is stored in auth_sessions (server-side; logout invalidates immediately).
# APP_BASE_URL is the public URL users open; Entra redirects and the CSRF origin
# check derive from it. Use https in production and keep SESSION_COOKIE_SECURE=true
# (set it to false only for plain-http development).
APP_BASE_URL=http://localhost:8084
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_NAME=ai4drr_session
# SESSION_TTL_HOURS=168

# Microsoft sign-in — primary (OpenID Connect authorization code + PKCE via MSAL). Two shapes,
# never both; leave everything empty and the Microsoft button is shown disabled ("not configured").
#
# (a) Azure AD B2C / Entra External ID user flows (tenant <name>.onmicrosoft.com on b2clogin.com).
#     The app registration (web platform) must list the redirect URI below AND the logout
#     redirect URI among its redirect URIs. http:// is accepted by B2C for localhost only.
#     Dev:  AZURE_B2C_REDIRECT_URI=http://localhost:8084/api/auth/entra/callback
#           AZURE_B2C_LOGOUT_REDIRECT_URI=http://localhost:8084/
#     Prod: https://<your host>/api/auth/entra/callback and https://<your host>/
#     A registered URI with another path on this app (e.g. /login/azure-callback) is served too.
#     The id_token must carry oid + emails (or email), given_name, family_name.
AZURE_B2C_TENANT_NAME=
AZURE_B2C_POLICY=B2C_1_signup_signin
AZURE_B2C_PASSWORD_RESET_POLICY=            # optional: B2C "Forgot your password?" user flow
AZURE_B2C_EDIT_PROFILE_POLICY=              # optional; read, not used by the app today
AZURE_B2C_CLIENT_ID=
AZURE_B2C_CLIENT_SECRET=***
AZURE_B2C_REDIRECT_URI=http://localhost:8084/api/auth/entra/callback
AZURE_B2C_LOGOUT_REDIRECT_URI=http://localhost:8084/
# AZURE_B2C_EDIT_PROFILE_REDIRECT_URI / AZURE_B2C_PASSWORD_RESET_REDIRECT_URI: legacy, not read —
# every user flow returns to the one redirect URI above.
#
# (b) A plain Entra ID tenant (no B2C): redirect URI = APP_BASE_URL + /api/auth/entra/callback.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_PATH=/api/auth/entra/callback
#
# Note: the B2C password-reset user flow only resets B2C (Microsoft) identities. Local
# email/password accounts use the app's own "Forgot password?" e-mail flow (E-MAIL below).

# Local email/password sign-in — secondary, off by default.
#   true  — the sign-in screens show the local form and "Forgot password?"; administrators can
#           invite people (24 h setup link → local password); `make admin` can bootstrap a new
#           administrator with a setup link; local forgot/reset e-mails work.
#   false — Microsoft-only mode: the local form, Forgot-password and reset views are hidden AND
#           refused by the API (403): local login, forgot/reset, invitation setup, inviting and
#           re-sending (listing/revoking stay), and `make admin` for an address without an
#           account (it promotes existing accounts only — the person signs in with Microsoft
#           once, then `make admin` again). Existing local accounts, password hashes, chats and
#           invitations are left untouched; set true again and they work as before.
# There is NO public registration in either mode. Values: true/1/yes/on, anything else = false.
# Entra-only deployment: LOCAL_AUTH_ENABLED=false + the AZURE_B2C_* (or ENTRA_*) block above.
LOCAL_AUTH_ENABLED=false
# PASSWORD_RESET_TTL_MINUTES=60

# CORS is off unless origins are listed here (the frontend is served from the same
# origin). Never use "*" together with cookie authentication.
# CORS_ALLOW_ORIGINS=https://www.preventionweb.net

# ==================== E-MAIL (invitations, password reset) ====================
# Used by the invitation flow (docs/architecture.md §8) and password reset (§6). EMAIL_TRANSPORT:
#   smtp — send through the host below (STARTTLS when SMTP_SECURE=false, implicit TLS when true)
#   file — development: write each message as an .eml under MAIL_FILE_DIR instead of sending
#   none — sending refused (inviting answers 503); the default
EMAIL_FROM='"AI4DRR Chatbot" <no-reply@example.org>'
EMAIL_TRANSPORT=none
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=***
SMTP_SECURE=false
# MAIL_FILE_DIR=logs/mail
# INVITATION_TTL_HOURS=24

# ==================== ADMIN AUTHENTICATION ====================
# Legacy value, read but NOT used by this application: administrators are ordinary
# users with users.is_admin = TRUE (make admin EMAIL=…), and /api/admin/* is guarded
# by the normal session cookie. Kept only for compatibility with the legacy .env.
ADMIN_PASSWORD=change-me-in-production

# ==================== API SERVER ====================
# Host to bind the FastAPI server to
# Default: 0.0.0.0 (all interfaces)
# For production, consider 127.0.0.1 with reverse proxy
API_HOST=0.0.0.0

# Port to run the FastAPI server on
# Default: 8000
API_PORT=8000

# CORS: see CORS_ALLOW_ORIGINS under AUTHENTICATION above (empty = same-origin only).

# Directory served as the static frontend at "/" when it contains index.html
# Default: frontend
FRONTEND_DIR=frontend

# ==================== LOGGING ====================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# ==================== AZURE AI FOUNDRY ====================
# Grounding with Bing Search — online web retrieval
# NOT PORTED YET: the standalone chatbot answers from the UNDRR knowledge base only.
# The values below are read into the configuration but nothing uses them; the text
# describes the legacy behaviour they will control once online retrieval is ported.
#
# When AZURE_FOUNDRY_ENDPOINT and AZURE_FOUNDRY_API_KEY are both set, the
# chatbot uses your Foundry deployment (with Bing grounding enabled) for all
# online lookups. This replaces the legacy Wikipedia / NOAA / DuckDuckGo
# fetchers and eliminates LEVEL 3+4 GPT-5 validation calls (cost saving).
#
# If the Foundry call fails or returns no citations, the legacy fetchers are
# used automatically as a silent fallback.
#
# AZURE_FOUNDRY_ENDPOINT  — project-scoped endpoint from:
#   Azure AI Foundry → your project → Overview → "Azure AI services" endpoint
# AZURE_FOUNDRY_API_KEY   — API key from the same resource
# AZURE_FOUNDRY_DEPLOYMENT — deployment name WITH Grounding with Bing enabled
#   (check: Foundry project → Models + endpoints → deployment name column)
#   In this project the grounding-capable deployment is: gpt-4o

AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o
# REST API version for the Foundry endpoint — NOT the model version shown in the portal.
# Find it by checking: Azure AI Foundry docs → REST API reference → chat completions
# Example values: 2025-03-01-preview, 2024-12-01-preview
AZURE_FOUNDRY_API_VERSION=